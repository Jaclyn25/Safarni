GooglePlaces__ApiKey=
GoogleRoutes__ApiKey=
GroqChat__ApiKey=
GroqItinerary__ApiKey=
GeminiItinerary__MaxOutputTokens=6000
# SerpAPI discovery lane: attractions, restaurants, and images
SerpApi__DiscoveryApiKey=
# SerpAPI commerce lane: airports, flights, and hotels
SerpApi__CommerceApiKey=
# Optional backwards-compatible single-key fallback
SerpApi__ApiKey=
# First administrator account (seeded idempotently at startup)
Admin__Email=
Admin__Password=
Admin__FullName=Safarni Administrator
# Stripe Checkout configuration (use test keys while developing)
Payments__Provider=Stripe
Payments__StripeSecretKey=your_stripe_secret_key
Payments__StripeWebhookSecret=your_stripe_webhook_secret
Frontend__BaseUrl=http://localhost:4200
# Optional idempotent Developer 1 marketplace test accounts.
# Creates marketplace.admin@safarni.local, verified.agency@safarni.local,
# and pending.agency@safarni.local with this password when enabled.
MarketplaceSeed__Enabled=false
MarketplaceSeed__Password=
